{
    "task": [
        {
            "name": "活动推图",
            "entry": "AutoPromotion",
            "option": [
                "故事模式",
                "小径",
                "探索模式",
                "推图吃糖"
            ],
            "pipeline_override": {
                "WaitReplay": {
                    "recognition": {
                        "param": {
                            "roi": [
                                1040,
                                575,
                                240,
                                100
                            ],
                            "expected": [
                                "复现",
                                "开始行动"
                            ]
                        }
                    }
                }
            },
            "group": ["standalone"],
            "description": "使用前请先手动进入活动关卡地图页，再运行本任务。<br>按选项依次执行三个阶段，可分别开关：<br><b>故事模式</b>——自动识别编号旁带灰色星标的未完成关卡并依次推进（剧情自动跳过、战斗使用当前队伍直接开始行动）；<br><b>小径</b>——自动遍历地图左侧小径任务列表（对话自动连点推进、阅读面板自动关闭）；<br><b>探索模式</b>——活动后期开放，未开放时自动跳过；已开放则切换到探索模式后继续推图。<br>遇到小游戏、特殊教程等无法自动处理的界面时任务会自动停止（出错截图见 debug/on_error），请手动完成后回到关卡地图页重新运行即可继续。"
        }
    ],
    "option": {
        "故事模式": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AP_StoryGate": {
                            "enabled": false
                        }
                    }
                }
            ],
            "description": "推进故事模式的未完成关卡"
        },
        "小径": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AT_TrailGate": {
                            "enabled": false
                        }
                    }
                }
            ],
            "description": "完成地图左侧小径列表中的全部任务"
        },
        "探索模式": {
            "type": "switch",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "AP_ExploreGate": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {}
                }
            ],
            "description": "推进探索模式的未完成关卡（活动后期开放，未开放时自动跳过）。默认关闭，探索模式开放后请手动开启"
        },
        "推图吃糖": {
            "label": "吃糖",
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "EatCandyStart": {
                            "attach": {
                                "valid_period": "24h"
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "EatCandy": {
                            "enabled": false
                        },
                        "EatMiniCandy": {
                            "enabled": false
                        },
                        "EatCandyStart": {
                            "enabled": false
                        },
                        "EatCandyPage": {
                            "enabled": false
                        }
                    }
                }
            ],
            "description": "体力耗尽时自动吃 24 小时内过期的糖（推图任务专用简化版，固定有效期）"
        }
    }
}
