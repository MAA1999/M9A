{
    "Start1999": {
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.shenlan.m.reverse1999.bilibili/com.ssgame.mobile.gamesdk.frame.AppStartUpActivity"
            }
        }
    },
    // B 服有启动广告：开启 base 里默认关闭的 CloseAd，识别参数沿用 base 的华为服实测值。
    // 跨资源包对 custom_recognition_param 是整体替换、不是字段合并，所以要调参必须在此
    // 重写整个 custom_recognition_param（没写的键会丢，不会继承 base）
    "CloseAd": {
        "enabled": true
    }
}
