{
    "UTTU": {
        "desc": "UTTU活动入口",
        "next": [
            "[JumpBack]UTTU_find_stage",
            "[JumpBack]UTTU_start_action",
            "[JumpBack]UTTU_get_card",
            "[JumpBack]UTTU_Combat",
            "[JumpBack]UTTU_Victory",
            "UTTU_End",
            "UTTU_End2"
        ]
    },
    "UTTU_find_stage": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    949,
                    0,
                    294,
                    718
                ],
                "template": "UTTU/UTTU_stage_flag.png"
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "UTTU_start_action": {
        "desc": "点击开始探索",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    893,
                    614,
                    286,
                    65
                ],
                "roi_offset": [
                    0,
                    0,
                    36,
                    0
                ],
                // @i18n-src: ["开始探索"]
                "expected": [
                    "开始探索",
                    "開始探索",
                    "(?i)Start\\b",
                    "探索開始",
                    "탐색 시작"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "UTTU_get_card": {
        "desc": "点击获得名人卡",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    553,
                    75,
                    198,
                    52
                ],
                "roi_offset": [
                    0,
                    0,
                    179,
                    0
                ],
                // @i18n-src: ["获得名人卡"]
                "expected": [
                    "获得名人卡",
                    "獲得名人卡",
                    "(?i)FAME\\s*Cards\\s*Obtained\\b",
                    "名士カード獲得",
                    "유명인 카드 획득"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "UTTU_Combat": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    22,
                    28,
                    205,
                    46
                ],
                "roi_offset": [
                    0,
                    0,
                    103,
                    0
                ],
                // @i18n-src: ["回合"]
                "expected": [
                    "回合",
                    "(?i)Round\\b",
                    "ターン",
                    "턴"
                ]
            }
        },
        "post_delay": 4000,
        "timeout": 60000
    },
    "UTTU_Victory": {
        "desc": "最佳回合数页面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    124,
                    192,
                    194,
                    66
                ],
                "roi_offset": [
                    0,
                    0,
                    56,
                    0
                ],
                // @i18n-src: ["最佳通关回合数"]
                "expected": [
                    "最佳通关回合数",
                    "最佳通關回合數",
                    "(?i)Rounds\\s*Taken\\b",
                    "最短クリアターン数",
                    "최고 클리어 턴 수"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "UTTU_End": {
        "desc": "UTTU结束flag",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    109,
                    492,
                    104,
                    39
                ],
                "roi_offset": [
                    0,
                    0,
                    52,
                    0
                ],
                // @i18n-src: ["市场货架"]
                "expected": [
                    "市场货架",
                    "市場貨架",
                    "(?i)UTTU\\s*Shop\\b",
                    "マート売り場",
                    "마켓 출시"
                ]
            }
        }
    },
    "UTTU_End2": {
        "desc": "UTTU结束flag2,战斗失败",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    481,
                    94,
                    308,
                    111
                ],
                "roi_offset": [
                    0,
                    0,
                    39,
                    0
                ],
                // @i18n-src: ["战斗失败"]
                "expected": [
                    "战斗失败",
                    "戰鬥失敗",
                    "(?i)DEFEAT\\b",
                    "FAILED",
                    "전투 패배"
                ]
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "$Focus.UTTU_End2"
            }
        }
    }
}
