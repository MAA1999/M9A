{
    // 翻斗棋（4.0 适配）
    // 入口链路（实机实测 2026-10-15，1280x720）：主页「神秘箱中遨游」banner → 畅游摩卢旁卡页
    //   →「参与游戏」→ 翻斗棋主菜单 →「箱中对决」→ 本次奇遇弹窗（下一步）→ 选择领队（全屏 3 卡）
    //   →「进入战斗」→ 对局页。
    // 对局页之后的节点沿用 3.5 的实测结论（Empty 0.987 / StartCombat 0.993）；
    // 卡牌模板也沿用（Cards/Deer.png 在 4.0 实战截图上 0.991，即鹿蜀美术未变）。
    //
    // 素材目录：全部平铺在 `CritterCrash/` 下（不再有版本子目录）—— 本项目只支持 4.0 界面，
    // 3.5 专用且无人引用的旧图（Start / ToDo / JiuNiangzi / Peoples/ 等）已删除。
    //
    // 判定方式约定（为 i18n 铺路）：
    //   · **带文字的按钮/标签一律走 OCR**：主菜单「翻斗历程」「箱中对决」、对局页「怪物粘贴处」、
    //     奇遇「下一步」、选领队「进入战斗」、入口页「参与游戏」。`expected` 写成数组，
    //     以后加语言就是往数组里加字符串，不用重新裁图。
    //   · 模板只留给**美术/图标/印章**（没有可读文字，换语言也不变）：Cards/ 棋子美术、Award/、
    //     Empty、Lv3 满级角标、Blank/、StartCombat/ 的 Battle 印章、SkipCombat / Spirit / Stop 图标、
    //     LeaderSelected 勾选圈、Leaders_<id> 棋手立绘。
    //
    // 两段式入口（重要）：
    //   · CritterCrashEntry = 任务入口，收「任意翻斗棋界面」（主菜单 / 对局页 / 选领队页），
    //     这样用户从对局中间启动也能接上（3.5 只认主菜单，从对局页启动会 status 4000 秒失败）。
    //   · CritterCrash      = 主菜单锚点，保持 3.5 语义（只认主菜单的「翻斗历程」），
    //     它被 CCFlagInCombatMain.next 当作「是否已回到主菜单」的判据使用。
    //   ⚠️ 不要把对局页判据并进 CritterCrash：那样会与 CCFlagInCombatMain.next 里的
    //      CritterCrash 形成 Entry→CCResetData→CCFlagInCombatMain→CritterCrash 死循环（已实测踩过）。
    //
    // 三条实测行为（2026-10-16 / 10-17，决定了下面的 next 排布）：
    //   1. 选领队页「进入战斗」在**没有选中领队时是禁用态**，点了不响应 —— 死等会让任务在
    //      这一页终结（status 4000）。所以 CCSelectPeople4p0 必须兜底选人，见 CCPickLeaderRec。
    //   2. **对局一旦建立就会续局**：退到主菜单再点「箱中对决」直接回到同一局（不再走奇遇/选领队），
    //      且已消耗 1 次次数。因此 CCStart.next 首项要能认对局页，否则续局时会死端。
    //   3. **换奇遇要靠「放弃」，光返回没用**（2026-10-17 实机）：奇遇弹窗/选领队页点左上返回只是回到
    //      主菜单，这一局还压着 —— 再点「箱中对决」原样回到同一局（同名奇遇：连摇 4 次都是「大鱼吃小鱼」，
    //      额度全白烧，这就是「重开流程不对」的根因）。真正的重摇是两步：
    //        返回回主菜单（CCPickEncounterRec 点的）→ 点「箱中对决」招牌右上角的 **✕（CCStop）**
    //        → 清掉「此时放弃对战评分不变，是否确认？」（CCRerollConfirm）→ 再点「箱中对决」。
    //      实测这样能摇到新奇遇（大鱼吃小鱼 → 天外飞箱），且 ✕ 放弃后立刻消失（它是条件出现的，
    //      「有未完成对局」才有，所以没局时 CCStop 自然 miss，不会误点）。
    //      ⚠️ 所以在每一处「准备开局」的 next 里，`[JumpBack]CCStop` 都必须排在 CCStart **之前** ——
    //      3.5 就是这个顺序，4.0 改写时把它排到了 CCStart 后面，于是永远轮不到它，主菜单上只会
    //      点「箱中对决」续局。
    //      结构约定（别改回复合节点）：**「点一下就走」的节点保持原子** —— `CCStop`（点 ✕ 放弃）
    //      与 `CCRerollConfirm`（点确认清框）都只有识别 + 点击、没有 next，调用方一律用
    //      `[JumpBack]X` 引用：点完回**调用方自己的列表**重新识别，后续决策（还要不要放弃、
    //      现在到底在哪一页、要不要开局）留在列表里。把 `→ CritterCrash → CCStart` 这种
    //      调用方续程写进被调节点的 next，会立刻和主菜单锚点互指成环（`CritterCrash ↔ CCStop`、
    //      `CritterCrash ↔ CCRerollConfirm`），还会硬路由跳过列表里的状态判断 —— 本轮第一版
    //      就是这么踩的；3.5 的 `[JumpBack]CCConfirm` 本来就是叶子写法。
    //      挂 `[JumpBack]CCStop` 的只有两处：主菜单锚点 `CritterCrash`（覆盖重摇 / 领队重摇 /
    //      活动入口页启动）与 `CCResetData`（任务入口直接就停在主菜单时）。
    "CritterCrashEntry": {
        "desc": "任务入口：任意翻斗棋界面（主菜单「翻斗历程」/ 对局页「怪物粘贴处」/ 选领队「进入战斗」/ 奇遇「下一步」/ 入口页「参与游戏」）—— 五路都是文字 OCR 判定",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "CritterCrash",
                    "CCFlagInCombatMain",
                    "CCEnterBattle",
                    "CCPlay",
                    "CCNext"
                ]
            }
        },
        "next": [
            "CCPlay",
            "CCResetData"
        ]
    },
    // 活动入口页（畅游摩卢旁卡）的「参与游戏」，点它进翻斗棋主菜单。
    // 放在 CCResetData 之前：在入口页时它先命中；在其它界面它不命中，由 CCResetData 兜底。
    "CCPlay": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1000,
                    555,
                    270,
                    90
                ],
                "expected": ["参与游戏"],
                "only_rec": true
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 2000,
        "next": [
            "CritterCrash",
            "CCStart",
            "CCResetData"
        ]
    },
    "CritterCrash": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1000,
                    15,
                    240,
                    58
                ],
                "expected": ["翻斗历程"],
                "only_rec": true
            }
        },
        "next": [
            // 主菜单锚点 = 「我在主菜单」时的唯一决策点：先清放弃框 → 还压着一局就先放弃 → 再开局。
            // 从活动入口页「参与游戏」进来走的就是这里（CCPlay.next 第 1 项），绕开了 CCResetData，
            // 所以「先放弃」这一刀必须挂在这儿，否则那条路径又会「点箱中对决续旧局」（原 bug 复现）。
            // CCStop 是原子节点（只认 ✕ + 点掉，没有 next），用 [JumpBack] 引用：点完回到本列表重新识别，
            // 下一轮由 CCRerollConfirm 清框 —— 这样 CCStop 不会和本节点互指成环。
            "[JumpBack]CCRerollConfirm",
            "[JumpBack]CCStop",
            "CCStart",
            "[JumpBack]CCConfirm",
            "[JumpBack]CCClickBlank"
        ]
    },
    "CCResetData": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "CCResetData",
                "custom_action_param": {
                    "strategy_file": "data/critter_crash/strategy-4.0.json"
                }
            }
        },
        "next": [
            "CCFlagInCombatMain",
            "CCFlagInSelectPeople",
            // 入口启动时也可能正压着「放弃对战」确认框：先清框，再决定去哪
            "[JumpBack]CCRerollConfirm",
            // 停在一页「本次奇遇」弹窗上时：先按名字门控，再翻页（主菜单上它不命中，不会抢 CCStart 的道）
            "CCEncounterAccept",
            "CCNext",
            // 主菜单上还压着一局（「箱中对决」右上角有 ✕）就先放弃：不放弃的话下面 CCStart 只会续局，
            // 永远摇不到新奇遇。✕ 只在有未完成对局时出现，没局时这一项自然 miss。
            // 用 [JumpBack] 而不是裸引用：点完 ✕ 回到本列表重新识别，由上面的 CCRerollConfirm 清框 ——
            // 既不用给 CCStop 挂 next（那是 3.5 的写法），也不会让它的 action 被反复重跑。
            "[JumpBack]CCStop",
            "CCStart",
            "[JumpBack]CCConfirm",
            "[JumpBack]CCClickBlank"
        ]
    },
    // 4.0 主菜单右下角「箱中对决」是当期唯一开局入口（3.5 的 Start.png 实测 0.184 已失效）
    "CCStart": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1030,
                    555,
                    250,
                    110
                ],
                "expected": ["箱中对决"],
                "only_rec": true
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1500,
        "next": [
            "CCFlagInCombatMain",
            "CCEncounterAccept",
            "CCNext",
            "CCSelectPeople4p0",
            "CCEnterBattle",
            "[JumpBack]CCRerollConfirm",
            "CCStart"
        ]
    }, // 4.0 新增：开局前的「本次奇遇」弹窗。用「下一步」按钮作门控（该按钮只存在于奇遇弹窗），
    // 不依赖 OCR —— 本机 OCR 实测在本资源包下返回 0 结果，无法离线验证，故避开 OCR。
    "CCNext": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1010,
                    612,
                    226,
                    50
                ],
                "expected": ["下一步"],
                "only_rec": true
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 800,
        "next": [
            "CCNext",
            "CCSelectPeople4p0",
            "CCEnterBattle",
            "CCFlagInSelectPeople",
            "CCFlagInCombatMain"
        ]
    },
    // 4.0 新增：选择领队页右下角「进入战斗」（kf 0021 实测置信度 1.0）
    "CCEnterBattle": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1000,
                    590,
                    255,
                    85
                ],
                "expected": ["进入战斗"],
                "only_rec": true
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1500,
        "next": [
            "CCFlagInCombatMain",
            "CCStartCombat",
            "CCEnterBattle"
        ]
    },
    // 主菜单「箱中对决」招牌右上角的橙底 ✕ = **放弃当前这一局**（不是「退出小游戏」，也不是常驻按钮：
    // 实测只在有未完成对局时出现，放弃后立刻消失；棋盘页/选领队页/奇遇弹窗上都没有它，不会在对局中误触发）。
    // 实测链路（2026-10-17，1280x720）：点 ✕(1231,576) → 弹「此时放弃对战评分不变，是否确认？」
    // →「确认」(800,427) → 主菜单（✕ 消失）→ 再点「箱中对决」= **新奇遇**。
    // 点击落点用识别框中心即可：✕ 圆心 (1231,576) 落在 ROI [1207,553,52,53] 中间；
    // 「确认」落在 CCRerollConfirm 既有 target [760,400,90,50] 内 —— 两处几何都不用改。
    //
    // **本节点刻意保持原子：只有识别 + 点击，没有 next**（沿用 3.5 的写法）。
    // 需要「先放弃再开局」的列表用 `[JumpBack]CCStop` 引用它：点完回父列表重新识别，
    // 由列表里排在 CCStart 之前的 CCRerollConfirm 清掉放弃框。反过来若给它挂 next
    // （点 ✕ → 清框 → 开局）并让别的节点再指回来，就会长出 CCStop ↔ CritterCrash 那种互指环。
    // 这里也**不挂泛化 `CCConfirm`（OCR「确认」）当兜底**：它在选领队页/主菜单实测 0.87/0.767
    // 相似度（阈值 0.3）会误命中并点掉 [766,404,70,34]；专用锚点「放弃对战」在真弹框上引擎实测
    // 0.979~0.9998，本来就不需要兜底。
    "CCStop": {
        "desc": "主菜单「箱中对决」右上角 ✕ = 放弃当前这局（只在有未完成对局时出现；原子节点，无 next）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1207,
                    553,
                    52,
                    53
                ],
                "template": [
                    "CritterCrash/Stop.png"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "CCConfirm": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    766,
                    404,
                    70,
                    34
                ],
                "expected": [
                    "确认"
                ],
                "only_rec": true
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "CCClickBlank": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    552,
                    655,
                    177,
                    63
                ],
                "template": [
                    "CritterCrash/Blank/"
                ]
            }
        },
        "action": {
            "type": "Click"
        }
    },
    "CCFlagInSelectPeople": {
        "desc": "4.0 选择领队页：标题 OCR（实测标题在 y≈72..117；旧的 [593,36,187,49] 落在标题上方，置信度 0 恒失配）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    550,
                    72,
                    220,
                    45
                ],
                "expected": [
                    "选择领队"
                ],
                "only_rec": true
            }
        },
        "next": [
            // 顺序要紧：没选领队时「进入战斗」是禁用态，先选人再点按钮。
            // 已经选过时 CCPickLeaderRec 会靠「已选中」角标返回 miss，直接落到 CCEnterBattle。
            "[JumpBack]CCSelectPeople4p0",
            "CCEnterBattle",
            "CCFlagInCombatMain"
            // 这里不再挂 [JumpBack]BackButton：返回键现在由 CCPickLeaderRec 显式点击（带额度），
            // 而泛化的 BackButton 会在选领队页反复命中（左上角就是返回箭头）→ 点返回的死环。
        ]
    },
    // 4.0 选领队：优先策略表指定的棋手（小叶尼塞 30027）；没摇到就点左上返回退出去重摇
    // （有上限，见 strategy-4.0.json 的 people.max_reroll），额度用尽才兜底点卡位 0。
    // 重摇必需：领队→卡包→棋子池，随机兜底可能整局买不到鹿蜀。
    // 点返回后回到主菜单，故 next 里补 CritterCrash/CCStart 把「再进箱中对决」接上。
    "CCSelectPeople4p0": {
        "desc": "4.0 选领队：优先小叶尼塞（30027），没摇到则退出重摇，最后兜底点卡位 0",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "CCPickLeaderRec"
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 800,
        "next": [
            "CCEnterBattle",
            "CCFlagInSelectPeople",
            // 「没摇到优先棋手就退出重摇」（people.max_reroll > 0 才走得到）也是两步：上面点返回回主菜单后，
            // 由主菜单锚点 CritterCrash 的 [JumpBack]CCStop 放弃这一局才算真重摇 —— 否则又回到同一局、
            // 同样 3 张卡。这里不重复挂 CCStop。
            "CritterCrash",
            "[JumpBack]CCRerollConfirm",
            "CCStart"
        ]
    },
    // CCPickLeaderRec 的取材节点：优先棋手立绘（模板路径按 Leaders_<id>.png 约定拼）。
    "CCPickLeader_Template": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    180,
                    1280,
                    420
                ],
                "template": [
                    "CritterCrash/Leaders_30027.png"
                ],
                "threshold": 0.85
            }
        }
    },
    // CCPickLeaderRec 的取材节点：「已被选中」角标。roi 由识别侧按卡位逐个覆盖。
    "CCLeaderSelected_Template": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    45,
                    460,
                    140,
                    70
                ],
                "template": [
                    "CritterCrash/LeaderSelected.png"
                ]
            }
        }
    },
    // 「此时放弃对战评分不变，是否确认？」弹窗 —— 退出重摇（点返回）和「箱中对决」都可能弹它。
    // 用「放弃对战」当 OCR 锚点（比泛化的「确认」精确得多，不会在别的界面假阳性 —— 泛化那个
    // 在选领队页/主菜单实测 0.87/0.767 相似度会误命中），命中后直接点右侧的「确认」按钮。
    // 不点掉它，后面的节点全被它盖住 → 20s 超时 → 任务 4000。
    //
    // **本节点也保持原子：只有识别 + 点击，没有 next**（与 CCStop 同一条约定，3.5 的
    // `[JumpBack]CCConfirm` 就是这么写的）。调用方一律 `[JumpBack]CCRerollConfirm`：
    // 点完回调用方列表重新识别。理由不是洁癖 —— 清框之后该干什么**是调用方的决定**：
    // 主菜单锚点要接着判「还有没有残局要放弃」，入口列表要重新判「当前到底在哪一页」。
    // 把 `→ CritterCrash → CCStart` 写死在这里，就等于让每条调用链都硬跳过这些判断
    // （4.0 原来就是这么写的，于是和 CritterCrash 互指成环，且在入口路径上会跳过「先放弃」）。
    "CCRerollConfirm": {
        "desc": "退出重摇的「放弃对战」确认框 → 点确认（原子节点，无 next，调用方用 [JumpBack] 引用）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    420,
                    295,
                    440,
                    42
                ],
                "expected": [
                    "放弃对战"
                ],
                "only_rec": true
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    760,
                    400,
                    90,
                    50
                ]
            }
        },
        "post_delay": 800
    },
    // 「本次奇遇」弹窗的名字门控：名字不在策略表白名单里就点返回退出去重摇。
    // 依据：棋子池由「奇遇 → 卡包」决定（领队只影响技能）；实测按领队重摇 15 次才中 1 次，
    // 而奇遇名是弹窗上的大号文字，OCR 稳定。名字可接受时返回 miss，交给 CCNext 翻页。
    // 重摇是**两步**（见文件头第 3 条）：这里的点击只是「返回主菜单」，返回本身不换奇遇 ——
    // 所以 next 里必须紧跟 CCStop（点 ✕ 放弃这局）再回 CCStart 重开，否则又回到同一局同名奇遇。
    "CCEncounterAccept": {
        "desc": "奇遇弹窗：名字不在白名单就退出重摇（判定见 CCPickEncounterRec）",
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "CCPickEncounterRec"
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 800,
        "next": [
            // 返回后落在主菜单 → 交给主菜单锚点：它会先按 [JumpBack]CCStop 放弃这一局，再重开
            // （见 CritterCrash.next 的注释）。这里不直接挂 CCStop，避免多入口各挂一份、语义漂移。
            "[JumpBack]CCRerollConfirm",
            "CritterCrash",
            "CCStart",
            "CCNext"
        ]
    },
