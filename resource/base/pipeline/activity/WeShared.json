        "post_delay": 800,
        "next": [
            "CheckStopping",
            "WeSharedClaimReward",
            "[JumpBack]ObtainedAwards",
            "WeSharedScoreCheck"
        ]
    },
    "WeSharedScoreCheck": {
        "desc": "停在活动页时的双重门控：诈唬分到 score_cap、或局数到 max_games，任一达标就结束。超限必须停在活动页 —— 进了牌桌总览再退出会被算作放弃本局",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    20,
                    100,
                    350,
                    90
                ],
                "expected": "共读之忆"
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "WeSharedScoreCheck",
                "custom_action_param": {
                    "score_cap": 9000
                }
            }
        },
        "next": [
            "CheckStopping",
            "WeSharedStartGame"
        ]
    },
    "WeSharedStartGame": {
        "desc": "活动页「开始游戏」→ 牌桌总览。点识别框中心（按钮文字在按钮内），不写死坐标",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    830,
                    540,
                    420,
                    90
                ],
                "expected": "开始游戏"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [
                430,
                505,
                420,
                36
            ]
        },
        "next": [
            "CheckStopping",
            "WeSharedDeckOverview",
            "WeSharedStartGame"
        ]
    },
    "WeSharedDeckOverview": {
        "desc": "牌桌总览（18 张牌铺开）：只做识别门控，由 WeSharedTurnLoop 决定是否开下一局并点「开始游戏」",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    430,
                    505,
                    420,
                    36
                ],
                "expected": "识破对手"
            }
        },
        "next": [
            "CheckStopping",
            "WeSharedTurnLoop"
        ]
    },
    "WeSharedTurnLoop": {
        "desc": "牌局循环：点牌桌总览上的「开始游戏」并自主驱动出牌/确认阶段直到「游戏结束」。局数上限不在这里判（见 WeSharedScoreCheck），本节点只记账并发布 max_games / mode（once 只跑一遍、full 跑到满分）",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "WeSharedTurnLoop",
                "custom_action_param": {
                    "max_games": 50
                }
            }
        },
        "next": [
            "CheckStopping",
            "WeSharedGameOver"
        ]
    },
    "WeSharedGameOver": {
        "desc": "游戏结束（仅作识别锚点，供自定义动作判定本局已结束）：本局积分由 WeSharedTurnLoop 读出来后写进运行日志",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    510,
                    85,
                    265,
                    70
                ],
                "expected": "游戏结束"
            }
        },
        "next": [
            "CheckStopping",
            "WeSharedExitGame"
        ]
    },
    "WeSharedGameScore": {
        "desc": "识别用：游戏结束页的「获得诈唬分」数值（本局积分，供结束单轮游戏的 toast 用）。这里的 roi 只是基础搜索区（留出 4 位数余量，实测 3 位笔画在 x 785..848 / y 482..506）：真正喂给识别模型的框由 agent 侧 digit_roi() 按墨迹收紧，因为数字是渐入的，面板出来之前这一带是「诈唬失败」横幅文字，固定框会把横幅认成数字（实测 300 读成 1300）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    745,
                    468,
                    130,
                    52
                ],
                "expected": "[0-9]+",
                "only_rec": true
            }
        }
    },
    "WeSharedReportSummary": {
        "desc": "报告节点：只由 WeSharedScoreCheck 通过 override_next 进入，收尾时把「任务结束，总共刷了 N 次」写进运行日志",
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "WeSharedReportFinish"
        ]
    },
    "WeSharedReportFinish": {
        "desc": "报告节点：只由 WeSharedReportSummary 引出，标记整条链结束",
        "recognition": {
            "type": "DirectHit"
        },
        "next": []
    },
    "WeSharedExitGame": {
        "desc": "游戏结束页「退出游戏」：点识别框中心回活动页，不写死坐标",
