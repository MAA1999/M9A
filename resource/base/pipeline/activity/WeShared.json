        ]
    },
    "WeSharedClaimReward": {
        "desc": "里程碑「领取」：点掉可领的奖励，弹出的「获得物品」交给公共 ObtainedAwards",
        "max_hit": 50,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    240,
                    552,
                    80,
                    46
                ],
                "expected": "领取"
