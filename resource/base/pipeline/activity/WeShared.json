            ]
        },
        "next": [
            "CheckStopping",
            "WeSharedEventHome",
            "WeSharedNavOverview"
        ]
    },
    "WeSharedEventHome": {
        "desc": "活动页：先领能领的里程碑奖励，再由 WeSharedScoreCheck 判断是否继续",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    20,
