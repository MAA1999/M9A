{
    "WeShared": {
        "desc": "任务入口：清空本次任务状态，再按当前界面选择导航（越具体的界面越靠前）",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "WeShared"
            }
        },
        "next": [
            "CheckStopping",
            "WeSharedEventHome",
            "WeSharedNavOverview",
            "WeSharedNavHome",
            "[JumpBack]ReturnMain"
        ]
    },
    "WeSharedNavHome": {
        "desc": "主界面：点左上角第三个图标（高礼帽 + 摊开的书）直接进「书页与小憩」。图标纵向会随主界面状态漂移约 30px，ROI 留足纵向余量并点识别框中心",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    280,
                    0,
                    160,
                    140
                ],
                "template": [
                    "WeShared/NavHomeHub.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [
                940,
                455,
                245,
                65
            ]
        },
        "next": [
            "CheckStopping",
            "WeSharedNavOverview",
            "WeSharedNavHome"
        ]
    },
    "WeSharedNavOverview": {
        "desc": "活动总览页：点「共读之忆」入口进活动页",
        "recognition": {
            "type": "OCR",
