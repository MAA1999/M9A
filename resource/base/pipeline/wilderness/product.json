    // 名片模板宽 119px，2/3≈79：begin/end_offset 各收缩 79px，把 MaaFW 的中心加权随机采样点限制在左/右 1/3 区域内。
    "SummonlngSuccess": {
        "desc": "滑动名片：And 组合「最左卡(index 0)」「最右卡(index -1)」两个子识别，Swipe 直接引用其识别框，从最左卡左 1/3 滑到最右卡右 1/3；两者都命中才进入，兼作“还有名片”的门控。",
        "max_hit": 10,
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__SummonlngCardFirst",
                    "__SummonlngCardLast"
                ]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": "__SummonlngCardFirst",
                "begin_offset": [
                    0,
                    0,
                    -79,
                    0
                ],
                "end": "__SummonlngCardLast",
                "end_offset": [
                    79,
                    0,
                    -79,
                    0
                ],
                "duration": 1000
            }
        },
        "post_delay": 1000,
        "next": [
            "SummonlngSuccess",
            "SummonlngSuccessBack"
        ]
    },
    "__SummonlngCardFirst": {
        "desc": "最左卡识别（index 0），供 SummonlngSuccess 的 And 子识别引用。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
