{
    "SwitchAccount": {
        "next": [
            "MainMenuFlag",
            "[JumpBack]MainMenuEntry",
            "[JumpBack]StartUp"
        ]
    },
    "MainMenuFlag": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    364,
                    84,
                    166,
                    125
                ],
                "template": "SwitchAccount/Detail.png"
            }
        },
        "next": [
            "SettingEntry",
            "[JumpBack]MenuRight"
        ]
    },
    "SettingEntry": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "sub_name": "SettingText",
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "roi": [
                                    33,
                                    457,
                                    515,
                                    214
                                ],
                                "expected": "[设置]"
                            }
                        }
                    },
                    {
                        "sub_name": "SettingBetweenNeighbors",
                        "recognition": {
                            "type": "And",
                            "param": {
                                "all_of": [
                                    {
                                        "sub_name": "SignInText",
                                        "recognition": {
                                            "type": "OCR",
                                            "param": {
                                                "roi": [
                                                    173,
                                                    575,
                                                    91,
                                                    60
                                                ],
                                                "expected": "签到"
                                            }
                                        }
                                    },
                                    {
                                        "sub_name": "UdimoriumText",
                                        "recognition": {
                                            "type": "OCR",
                                            "param": {
                                                "roi": [
                                                    399,
                                                    575,
                                                    115,
                                                    60
                                                ],
                                                "expected": "冲印箱"
                                            }
                                        }
                                    },
                                    {
                                        // 「设置」所在的格子，也是兜底命中时的点击范围（DirectHit 的框就是 roi）。
                                        // 坐标取自同一页的 OCR 实测（720p）：公告 [79,588,52,32]、签到 [193,590,51,30]、
                                        // 冲印箱 [419,590,75,28]，上一排同列是好友 [307,502,50,31]，所以「设置」是第二排第 3 格。
                                        // 菜单排版变了要和上面 SignInText、UdimoriumText 的 roi 一起改。
                                        "sub_name": "SettingSlot",
                                        "recognition": {
                                            "type": "DirectHit",
                                            "param": {
                                                "roi": [
                                                    306,
                                                    588,
                                                    52,
                                                    32
                                                ]
                                            }
                                        }
                                    }
                                ],
                                "box_index": 2
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_wait_freezes": {
            "time": 300,
            "target": [
                52,
                450,
                122,
                174
            ]
        },
        "next": [
            "StartGameFlag",
            "SettingEntry",
            "[JumpBack]AccountExitConfirm",
            "[JumpBack]AccountExit",
            "[JumpBack]AccountSettingEnter"
        ]
    },
