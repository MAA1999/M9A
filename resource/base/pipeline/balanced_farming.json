{
    "BalancedFarming": {
        "desc": "任务入口：重置库存保持规划状态",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DepotMaintainInit"
            }
        },
        "next": [
            "BF_Plan"
        ]
    },
    "BF_Plan": {
        "desc": "库存保持规划：读仓库快照与目标库存，决定刷取目标、刷新快照或退回原有流程",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DepotMaintainPlan"
            }
        },
        "next": [
            "BF_EnterWarehouse",
            "[JumpBack]ReturnMain"
        ]
    },
    "BF_Refresh": {
        "desc": "库存保持：快照过期或缺失时执行一次仓库全量扫描",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DepotMaintainRefresh"
            }
        },
        "next": [
            "BF_Plan"
        ]
    },
    "BF_Done": {
        "desc": "库存保持：全部达标，直接收尾",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DepotMaintainDone"
            }
        }
    },
    "BF_DepotAccumulate": {
        "desc": "库存保持：结算页累计本局掉落，达标后当前批次收尾（由 SelectCombatStage 按 attach.depot_accumulate 挂进胜利链）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    678,
                    10,
                    473,
                    240
                ],
                "expected": [
                    "战斗",
                    "胜利"
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "DepotMaintainAccumulate"
            }
        },
        "next": []
    },
    "BF_EnterWarehouse": {
        "desc": "主界面左侧栏点击仓库入口",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    57,
                    372,
                    42,
                    22
                ],
                "expected": "仓库",
                "only_rec": true
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 2000,
        "next": [
            "BF_WarehouseFlag",
            "BF_EnterWarehouse"
        ]
    },
    "BF_WarehouseFlag": {
        "desc": "确认已进入仓库界面（左侧分类页签出现）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    30,
                    140,
                    140,
                    360
                ],
                "expected": "消耗品"
            }
        },
        "post_delay": 1000,
        "next": [
            "BF_Analyze"
        ]
    },
    "BF_Analyze": {
        "desc": "识别紫色材料数量并选定刷取关卡",
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "BalancedFarmingAnalyze"
            }
        },
        "next": [
            "BF_ExitWarehouse"
        ]
    },
    "BF_ExitWarehouse": {
        "desc": "点击返回键退出仓库（不占用 ReturnMain 配额）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    0,
                    134,
                    138
                ],
                "template": "StartUp/BackButton.png",
                "green_mask": true
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 2000,
        "next": [
            "BF_AtMain",
            "BF_ExitWarehouse"
        ]
    },
    "BF_AtMain": {
        "desc": "确认已回到主界面（左侧栏出现仓库入口）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    57,
                    372,
                    42,
                    22
                ],
                "expected": "仓库",
                "only_rec": true
            }
        },
        "next": [
            "Combat"
        ]
    },
    "BF_ItemIcon": {
        "desc": "供 BalancedFarmingAnalyze 调用：仓库网格中匹配单个材料图标",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    160,
                    90,
                    1120,
                    630
                ],
                "template": "Warehouse/Item-110103.png",
                "green_mask": true,
                "threshold": 0.9,
                "order_by": "Score"
            }
        }
    },
    "BF_ItemCount": {
        "desc": "供 BalancedFarmingAnalyze 调用：识别图标下方数量文字",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    0,
                    100,
                    40
                ],
                "only_rec": true
            }
        }
    }
}
