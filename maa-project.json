{
    "schemaVersion": 1,
    "project": {
        "displayName": "M9A",
        "slug": "m9a",
        "version": "v0.1.0",
        "initialTemplate": "agent"
    },
    "addons": {
        "autoFormat": {"enabled": true},
        "community": {"enabled": true},
        "dependabot": {"enabled": true},
        "devTools": {"enabled": true},
        "gitCliff": {"enabled": true},
        "github": {"enabled": true},
        "optimizeImages": {"enabled": true},
        "schemaSync": {"enabled": true}
    },
    "controller": {
        "kinds": [
            "Adb",
            "Win32",
            "PlayCover"
        ]
    },
    "resources": [
        {
            "enabled": true,
            "label": "Base",
            "path": "resource/base",
            "slug": "base"
        }
    ],
    "maafw": {
        "channel": "latest"
    },
    "runtime": {
        "mfa": {"channel": "latest", "enabled": true},
        "mxu": {"channel": "latest", "enabled": true}
    },
    "ocr": {
        "source": "submodule",
        "submodulePath": "MaaCommonAssets/OCR",
        "files": {
            "ppocr_v4/zh_cn/det.onnx": "det.onnx",
            "ppocr_v4/zh_cn/rec.onnx": "rec.onnx",
            "ppocr_v4/zh_cn/keys.txt": "keys.txt"
        }
    },
    "python": {
        "devCommand": [
            "uv",
            "run",
            "python",
            "agent/bootstrap.py"
        ],
        "recommendedPython": "3.13",
        "requiresPython": ">=3.13,<3.14"
    },
    "network": {
        "mode": "auto"
    },
    "license": {
        "spdx": "AGPL-3.0-or-later"
    },
    "features": {
        "ci": {"enabled": true},
        "quality": {"enabled": true},
        "release": {"enabled": true},
        "vscode": {"enabled": true}
    }
}
