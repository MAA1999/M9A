{
    "task": [
        {
            "name": "每日心相（意志解析）",
            "label": "$Task.Psychube",
            "entry": "Psychube",
            "group": [
                "daily"
            ],
            "option": [
                "双重解析加成作战",
                "吃糖"
            ]
        }
    ],
    "option": {
        "双重解析加成作战": {
            "type": "switch",
            "label": "$Option.Psychube.DoubleAnalysisBattle",
            "description": "$Option.Psychube.DoubleAnalysisBattle.desc",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "PsychubeDouble": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {}
                }
            ]
        },
        "吃糖": {
            "type": "switch",
            "label": "$Option.Psychube.ConsumeCandy",
            "description": "$Option.Psychube.ConsumeCandy.desc",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "糖果有效期",
                        "自定义吃糖次数",
                        "连续吃糖",
                        "允许体力溢出",
                        "关闭吃糖提示"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "EatCandy": {
                            "enabled": false
                        },
                        "EatMiniCandy": {
                            "enabled": false
                        },
                        "EatCandyStart": {
                            "enabled": false
                        },
                        "EatCandyPage": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "糖果有效期": {
            "type": "select",
            "label": "$Option.Psychube.CandyExpiry",
            "description": "$Option.Psychube.CandyExpiry.desc",
            "cases": [
                {
                    "name": "24h",
                    "description": "$Option.Psychube.CandyExpiry.24h.desc",
                    "pipeline_override": {
                        "EatCandyStart": {
                            "attach": {
                                "valid_period": "24h"
                            }
                        }
                    }
                },
                {
                    "name": "7d",
                    "description": "$Option.Psychube.CandyExpiry.7d.desc",
                    "pipeline_override": {
                        "EatCandyStart": {
                            "attach": {
                                "valid_period": "7d"
                            }
                        }
                    }
                },
                {
                    "name": "14d",
                    "description": "$Option.Psychube.CandyExpiry.14d.desc",
                    "pipeline_override": {
                        "EatCandyStart": {
                            "attach": {
                                "valid_period": "14d"
                            }
                        }
                    }
                },
                {
                    "name": "无限期",
                    "label": "$Option.Psychube.CandyExpiry.Unlimited",
                    "description": "$Option.Psychube.CandyExpiry.Unlimited.desc",
                    "pipeline_override": {
                        "EatCandyStart": {
                            "attach": {
                                "valid_period": "infinite"
                            }
                        }
                    }
                }
            ]
        },
        "自定义吃糖次数": {
            "type": "switch",
            "label": "$Option.Psychube.CustomCandyCount",
            "description": "$Option.Psychube.CustomCandyCount.desc",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "EatCandyStart": {
                            "max_hit": 114514
                        }
                    }
                },
                {
                    "name": "Yes",
                    "option": [
                        "吃糖次数"
                    ]
                }
            ]
        },
        "吃糖次数": {
            "type": "input",
            "label": "$Option.Psychube.CandyCount",
            "description": "$Option.Psychube.CandyCount.desc",
            "inputs": [
                {
                    "name": "吃糖次数",
                    "label": "$Option.Psychube.CandyCount.Count",
                    "default": "114514",
                    "pipeline_type": "int",
                    "verify": "^(0|[1-9]\\d*)$"
                }
            ],
            "pipeline_override": {
                "EatCandyStart": {
                    "max_hit": "{吃糖次数}"
                }
            }
        },
        "连续吃糖": {
            "type": "switch",
            "label": "$Option.Psychube.ContinuousCandy",
            "description": "$Option.Psychube.ContinuousCandy.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "EatCandyStart": {
                            "attach": {
                                "fast": 1
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "EatCandyStart": {
                            "attach": {
                                "fast": 0
                            }
                        }
                    }
                }
            ]
        },
        "允许体力溢出": {
            "type": "switch",
            "label": "$Option.Psychube.AllowApOverflow",
            "description": "$Option.Psychube.AllowApOverflow.desc",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "EatCandyStart": {
                            "attach": {
                                "allow_overflow": 0
                            }
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "EatCandyStart": {
                            "attach": {
                                "allow_overflow": 1
                            }
                        }
                    }
                }
            ]
        },
        "关闭吃糖提示": {
            "type": "switch",
            "label": "$Option.Psychube.DismissCandyPrompt",
            "description": "$Option.Psychube.DismissCandyPrompt.desc",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "EatCandyCloseTip": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "EatCandyCloseTip": {
                            "enabled": true
                        }
                    }
                }
            ]
        }
    }
}
