{
    "task": [
        {
            "name": "银行购物",
            "label": "$Task.Bank",
            "entry": "Bank",
            "option": [
                "柜台特奉",
                "低阶柜台",
                "心相观测",
                "梦境记述"
            ],
            "group": [
                "daily"
            ],
            "description": "$Task.Bank.desc"
        }
    ],
    "option": {
        "柜台特奉": {
            "type": "switch",
            "label": "$Option.Bank.CounterSpecials",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "FreeWeeklyGift": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {}
                }
            ],
            "description": "$Option.Bank.CounterSpecials.desc"
        },
        "低阶柜台": {
            "type": "checkbox",
            "label": "$Option.Bank.LowerCounter",
            "default_case": [
                "金兔子(低阶柜台)"
            ],
            "cases": [
                {
                    "name": "金兔子(低阶柜台)",
                    "label": "$Option.Bank.LowerCounter.GoldRabbit",
                    "icon": "./resource/announcement/images/Item-140001.png",
                    "pipeline_override": {
                        "Rabbit": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "紫地球仪(低阶柜台)",
                    "label": "$Option.Bank.LowerCounter.PurpleGlobe",
                    "icon": "./resource/announcement/images/Item-180002.png",
                    "pipeline_override": {
                        "SmallGlobe": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "蓝地球仪(低阶柜台)",
                    "label": "$Option.Bank.LowerCounter.BlueGlobe",
                    "icon": "./resource/announcement/images/Item-180001.png",
                    "pipeline_override": {
                        "TinyGlobe": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "心相观测": {
            "type": "checkbox",
            "label": "$Option.Bank.PsychubeObservation",
            "cases": [
                {
                    "name": "饕餮",
                    "label": "$Option.Bank.PsychubeObservation.Taotie",
                    "icon": "./resource/announcement/images/Equipment_suit-1000.png",
                    "pipeline_override": {
                        "Gluttony": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "蓝地球仪(心相观测)",
                    "label": "$Option.Bank.PsychubeObservation.BlueGlobe",
                    "icon": "./resource/announcement/images/Item-180001.png",
                    "pipeline_override": {
                        "TinyGlobe(1)": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "启寤Ⅱ",
                    "label": "$Option.Bank.PsychubeObservation.Enlighten2",
                    "icon": "./resource/announcement/images/Equipment_suit-1003.png",
                    "pipeline_override": {
                        "EnlightenmentII": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "启寤Ⅰ",
                    "label": "$Option.Bank.PsychubeObservation.Enlighten1",
                    "icon": "./resource/announcement/images/Equipment_suit-1002.png",
                    "pipeline_override": {
                        "EnlightenmentI": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "梦境记述": {
            "type": "checkbox",
            "label": "$Option.Bank.DreamNarrative",
            "default_case": [
                "共鸣晶匣"
            ],
            "cases": [
                {
                    "name": "共鸣晶匣",
                    "label": "$Option.Bank.DreamNarrative.ResonanceCrystalBox",
                    "icon": "./resource/announcement/images/Item-481005.png",
                    "pipeline_override": {
                        "ResonantCassette": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "金瓜子(梦境记述)",
                    "label": "$Option.Bank.DreamNarrative.GoldSeed",
                    "icon": "./resource/announcement/images/Item-120011.png",
                    "pipeline_override": {
                        "GoldenMelonSeeds": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "原味鸡(梦境记述)",
                    "label": "$Option.Bank.DreamNarrative.OriginalChicken",
                    "icon": "./resource/announcement/images/Item-120012.png",
                    "pipeline_override": {
                        "OriginalChicken": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "大薯(梦境记述)",
                    "label": "$Option.Bank.DreamNarrative.LargeFries",
                    "icon": "./resource/announcement/images/Item-120013.png",
                    "pipeline_override": {
                        "Fries": {
                            "enabled": true
                        }
                    }
                }
            ]
        }
    }
}
