{
    "task": [
        {
            "name": "活动代币刷取",
            "label": "$Task.CombatActivity",
            "entry": "CombatActivity",
            "description": "$Task.CombatActivity.desc",
            "group": [
                "daily"
            ],
            "option": [
                "复刻模式",
                "活动难度",
                "吃糖",
                "自定义作战次数"
            ]
        }
    ],
    "option": {
        "复刻模式": {
            "type": "switch",
            "label": "$Option.CombatActivity.RerunMode",
            "description": "$Option.CombatActivity.RerunMode.desc",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "CombatActivityOverride": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "mode": 0
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "CombatActivityOverride": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "mode": 1
                                    }
                                }
                            }
                        },
                        "JudgeDuringRe_release": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "活动难度": {
            "type": "select",
            "label": "$Option.CombatActivity.EventDifficulty",
            "cases": [
                {
                    "name": "艰难",
                    "label": "$Option.CombatActivity.EventDifficulty.Arduous",
                    "pipeline_override": {
                        "ActivityTargetLevel": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "level": "艰难"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "意外",
                    "label": "$Option.CombatActivity.EventDifficulty.Surprise",
                    "pipeline_override": {
                        "ActivityTargetLevel": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "level": "意外"
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "故事",
                    "label": "$Option.CombatActivity.EventDifficulty.Story",
                    "pipeline_override": {
                        "ActivityTargetLevel": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "level": "故事"
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}
