{
    "task": [
        {
            "name": "切换账号",
            "label": "$Task.SwitchAccount",
            "entry": "SwitchAccount",
            "description": "$Task.SwitchAccount.desc",
            "group": [
                "daily"
            ],
            "resource": [
                "官服"
            ],
            "option": [
                "目标账号(可选)"
            ]
        }
    ],
    "option": {
        "目标账号(可选)": {
            "type": "input",
            "label": "$Option.SwitchAccount.TargetAccount",
            "inputs": [
                {
                    "name": "账号",
                    "label": "$Option.SwitchAccount.TargetAccount.Account",
                    "description": "$Option.SwitchAccount.TargetAccount.Account.desc",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": ".*"
                }
            ],
            "pipeline_override": {
                "SwitchAccountSelect": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "account": "{账号}"
                            }
                        }
                    }
                }
            }
        }
    }
}
