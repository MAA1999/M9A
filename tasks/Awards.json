{
    "task": [
        {
            "name": "领取奖励",
            "label": "$Task.Awards",
            "entry": "Awards",
            "option": [
                "领取邮件奖励",
                "领取任务奖励",
                "领取吼吼点唱机",
                "领取前线观察室奖励",
                "综合体日常",
                "活动盒子奖励",
                "迷思海周扫荡奖励",
                "领取拉普拉斯论坛奖励"
            ],
            "group": [
                "daily"
            ]
        }
    ],
    "option": {
        "领取邮件奖励": {
            "type": "switch",
            "label": "$Option.Awards.Mail",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Sub_MailBadge": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "领取任务奖励": {
            "type": "switch",
            "label": "$Option.Awards.Tasks",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Sub_DailyBadge": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "领取每日活跃奖励",
                        "领取每周活跃奖励"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Sub_DailyBadge": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "领取每日活跃奖励": {
            "type": "switch",
            "label": "$Option.Awards.DailyActivity",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Sub_CollectDailyAwards": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "领取每周活跃奖励": {
            "type": "switch",
            "label": "$Option.Awards.WeeklyActivity",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "领取每周显影罐"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "WeeklyAwardsBadge": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "领取每周显影罐": {
            "type": "switch",
            "label": "$Option.Awards.WeeklyDevelopingJar",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "WeeklyAwardsCompleted": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "ShowFlag": {
                            "next": [
                                "DevelopmentTank"
                            ]
                        }
                    }
                }
            ]
        },
        "领取吼吼点唱机": {
            "type": "switch",
            "label": "$Option.Awards.Jukebox",
            "cases": [
                {
                    "name": "Yes"
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Sub_JukeboxBadge": {
                            "enabled": false
                        },
                        "Sub_JukeboxBadge_3.7": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "领取前线观察室奖励": {
            "type": "switch",
            "label": "$Option.Awards.FrontlineObservationRoom",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AwardWarRoom": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "综合体日常": {
            "type": "switch",
            "label": "$Option.Awards.ComplexDaily",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AwardComplexDaily": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "有终的劳作",
                        "婆婆的秩序"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AwardComplexDaily": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "有终的劳作": {
            "type": "switch",
            "label": "$Option.Awards.LabourWithAnEnd",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AwardComplexLabor": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AwardComplexLabor": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "婆婆的秩序": {
            "type": "switch",
            "label": "$Option.Awards.GrannysOrder",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AwardGrannyOrder": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AwardGrannyOrder": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "领取拉普拉斯论坛奖励": {
            "description": "$Option.Awards.LaplaceForum.desc",
            "type": "switch",
            "label": "$Option.Awards.LaplaceForum",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "EventLaplace": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {}
                }
            ]
        },
        "活动盒子奖励": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AwardBox": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "活动奖励·狂想与解构",
                        "活动奖励·崭新的电波",
                        "活动奖励·吼吼狂欢夜",
                        "活动奖励·播种于月光下"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AwardBox": {
                            "enabled": false
                        }
                    }
                }
            ],
            "label": "$Option.Awards.EventBox"
        },
        "活动奖励·狂想与解构": {
            "type": "switch",
            "label": "$Option.Awards.EventRhapsody",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AwardEuphoriaAndLucidity": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AwardEuphoriaAndLucidity": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "活动奖励·崭新的电波": {
            "type": "switch",
            "label": "$Option.Awards.EventNewWaves",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AwardBreakingSignals": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AwardBreakingSignals": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "活动奖励·吼吼狂欢夜": {
            "type": "switch",
            "label": "$Option.Awards.EventRoarCarnival",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AwardRoaringRevelry": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AwardRoaringRevelry": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "活动奖励·播种于月光下": {
            "type": "switch",
            "label": "$Option.Awards.EventSownMoonlight",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AwardMoonlightGardening": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AwardMoonlightGardening": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "迷思海周扫荡奖励": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "AwardReveriesInTheRain": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "AwardReveriesInTheRain": {
                            "enabled": false
                        }
                    }
                }
            ],
            "label": "$Option.Awards.MysterySeaWeekly"
        }
    }
}
